{
  "name": "bookclub",
  "version": "0.2.0",
  "private": true,
  "description": "Modern textbook exchange app with a React client and local Express API.",
  "scripts": {
    "dev": "npm run dev:server",
    "dev:client": "npm --prefix client run dev",
